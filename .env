# ─────────────────────────────────────────────
# JUNIORS AI CHAT v10.5 — FULL SPOOF / ANTI-BOT
# ─────────────────────────────────────────────
# NOTE: For Render, set these as Environment Variables
# in the Render dashboard instead of this file.
# This file is for local dev reference only.

# === Kick API Credentials ===
KICK_CLIENT_ID=YOUR_KICK_CLIENT_ID
KICK_CLIENT_SECRET=YOUR_KICK_CLIENT_SECRET
KICK_REDIRECT_URI=https://your-app.onrender.com/auth/kick/callback
KICK_CHANNEL_SLUG=YOUR_CHANNEL_NAME

# === OpenAI ===
OPENAI_API_KEY=sk-YOUR_OPENAI_KEY

# === Dashboard ===
SESSION_SECRET=CHANGE_ME_TO_A_RANDOM_STRING
DASHBOARD_PASSWORD=CHANGE_ME

# ─── ANTI-DETECTION / FINGERPRINT SPOOFING ───
# Master switch for all fingerprint/TLS spoofing
ENABLE_FINGERPRINT_SPOOFING=true

# Human typing delay (pauses before sending messages like a real person)
ENABLE_HUMAN_DELAY=true

# TLS impersonation — uses curl-impersonate binary for JA3 spoofing
# Render doesn't have curl-impersonate by default, so TLS falls back to header-only.
# To get full TLS JA3 spoofing on Render, see the note below.
CURL_IMPERSONATE_BIN=
CURL_IMPERSONATE=chrome131
TLS_FETCH_TIMEOUT_MS=15000

# ─── BROWSER ACCOUNT ISOLATION (Puppeteer) ───
# Launches a real Chromium browser per account for full session/profile separation.
ACCOUNT_BROWSER_ENABLED=true
ACCOUNT_BROWSER_HEADLESS=true
ACCOUNT_BROWSER_ROOT=./browser-profiles
ACCOUNT_BROWSER_START_TIMEOUT_MS=45000

# ─── PROXIES (SOCKS5) ───
# Route each account through a different proxy for IP diversity.
# Comma-separated: socks5://user:pass@host:port,socks5://user:pass@host:port
# ACCOUNT_SOCKS5_PROXIES=
# ACCOUNT_SOCKS5_ROTATION=round-robin

# ─── AI BEHAVIOR ───
BOT_NAME=AI Co-host
STREAMER_NAME=Streamer
AUTO_SEND=true
ENABLE_CRITIC=true